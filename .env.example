DATABASE_URL=postgresql+asyncpg://commerce_agent:commerce_agent@localhost:7600/commerce_agent
REDIS_URL=redis://localhost:7601/0
RABBITMQ_URL=amqp://commerce_agent:commerce_agent@localhost:7602/
# 异步执行模式（outbox: 通过 PostgreSQL Outbox + RabbitMQ Worker 异步执行；inline: 请求内同步执行）
ASYNC_EXECUTION_MODE=outbox

AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=true
# 沙箱固定业务日（默认 2026-11-21；设为 live 则使用实时系统日期）
SANDBOX_BUSINESS_DATE=2026-11-21

LLM_PROVIDER=dashscope
# 结构化输出模式（function_calling 或 json_schema，可按渠道单独覆盖）
LLM_STRUCTURED_OUTPUT_MODE=function_calling
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# 默认模型与高阶模型
DASHSCOPE_DEFAULT_MODEL=qwen-plus
DASHSCOPE_HIGH_CAPABILITY_MODEL=qwen-max

OPENAI_RELAY_BASE_URL=
OPENAI_RELAY_API_KEY=
# 默认模型与高阶模型
OPENAI_RELAY_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_RELAY_HIGH_CAPABILITY_MODEL=gpt-4.1
